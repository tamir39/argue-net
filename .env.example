# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored.

# === LLM providers ===
# Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Lấy ở https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama local — chỉ cần nếu chạy local LLM
OLLAMA_BASE_URL=http://localhost:11434

# === Agent model routing ===
# Đặt model cho từng vai. Provider được suy ra từ prefix:
#   gemini/<model>     → Google Gemini (cần GEMINI_API_KEY)
#   anthropic/<model>  → Anthropic Claude (cần ANTHROPIC_API_KEY)
#   ollama/<model>     → Ollama local (cần Ollama đang chạy)
#
# Ví dụ cấu hình "mỗi vai một provider khác nhau" để né quota:
#   JARVIS_MODEL=anthropic/claude-sonnet-4-5
#   PRO_AGENT_MODEL=gemini/gemini-2.5-flash
#   CON_AGENT_MODEL=gemini/gemini-2.5-flash-lite
#   MEDIATOR_MODEL=ollama/llama3
JARVIS_MODEL=gemini/gemini-2.5-flash
PRO_AGENT_MODEL=gemini/gemini-2.5-flash
CON_AGENT_MODEL=gemini/gemini-2.5-flash
MEDIATOR_MODEL=gemini/gemini-2.5-flash

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# === Frontend (Phase 3) ===
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
