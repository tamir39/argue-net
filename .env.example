# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored.

# === LLM providers ===
# Lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Lấy ở https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama local — chỉ cần nếu chạy local LLM
OLLAMA_BASE_URL=http://localhost:11434

# === Agent model routing (Phase 4) ===
# Đặt model cho từng vai. Tham khảo cú pháp model của LiteLLM:
# https://docs.litellm.ai/docs/providers
JARVIS_MODEL=gemini/gemini-2.0-flash
PRO_AGENT_MODEL=gemini/gemini-2.0-flash
CON_AGENT_MODEL=gemini/gemini-2.0-flash
MEDIATOR_MODEL=gemini/gemini-2.0-flash

# === Backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# === Frontend (Phase 3) ===
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
